<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>trinity-vocab</AssemblyName>
    <RootNamespace>Semiodesk.Trinity.Vocabulary.Cli</RootNamespace>
    <Title>Semiodesk.Trinity.Vocabulary.Cli</Title>
    <Description>Command line tool that generates Semiodesk.Trinity vocabulary classes from RDF files.</Description>
    <!-- Distinct from the engine's assembly name (Semiodesk.Trinity.Vocabulary), which NuGet would
         otherwise see as an ambiguous project reference. Installed as a tool, invoked as trinity-vocab. -->
    <PackageId>Semiodesk.Trinity.Vocabulary.Tool</PackageId>
    <PackageTags>RDF SPARQL ontology vocabulary code generation dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>trinity-vocab</ToolCommandName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trinity.Vocabulary\Trinity.Vocabulary.csproj" />
  </ItemGroup>

  <!-- The runner and manifest reader are internal; the tests drive them directly so the check-mode exit
       codes are covered without launching a process. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Semiodesk.Trinity.Vocabulary.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
