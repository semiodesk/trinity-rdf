<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <Title>Semiodesk.Trinity.Fuseki</Title>
    <Copyright>Copyright © Semiodesk GmbH 2015-2023</Copyright>
    <Description>This package provides an Apache Jena Fuseki store adapter for the Trinity RDF ORM.</Description>
    <Company>Semiodesk GmbH</Company>
    <AssemblyName>Semiodesk.Trinity.Fuseki</AssemblyName>
    <RootNamespace>Semiodesk.Trinity.Store.Fuseki</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>


  <PropertyGroup>
    <OutputPath>..\Build\$(Configuration)\stores\fuseki</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageProjectUrl>https://trinity-rdf.net</PackageProjectUrl>
    <PackageIcon>trinity-logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/semiodesk/trinity-rdf</RepositoryUrl>
    <PackageTags>RDF SPARQL Database Semantic Object Mapping Linked Data Apache Jena Fuseki</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

  </PropertyGroup>
  
  <ItemGroup>
    <None Include="..\assets\trinity-logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotNetRDF" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Data.Common" />
    <PackageReference Include="System.Security.Permissions" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Trinity\Trinity.csproj" />
  </ItemGroup>

</Project>