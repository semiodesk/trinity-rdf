<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Core / store library dependencies -->
  <ItemGroup>
    <!-- dotNetRDF 3.x is split: Core = RDF/SPARQL engine, Client = HTTP storage connectors. -->
    <!-- Pulled in transitively by dotNetRdf.Core, which asks for 1.4.0 — affected by GHSA-pgww-w46g-26qg
         (mXSS, moderate, fixed in 1.5.0). Referenced directly so consumers do not inherit a package
         with a known advisory. Trinity itself never parses HTML, so this is hygiene, not an exposure. -->
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="dotNetRdf.Core" Version="3.5.2" />
    <PackageVersion Include="dotNetRdf.Client" Version="3.5.2" />
    <!-- RdfsReasoner (in-memory inferencing) moved out of Core in 3.x. -->
    <PackageVersion Include="dotNetRdf.Inferencing" Version="3.5.2" />
    <!-- 13.0.4 is the floor dotNetRdf.Core 3.5.2 requires. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="System.Composition" Version="1.1.0" />
    <!-- Needed only by Trinity.Virtuoso: the vendored OpenLink.Data.Virtuoso.dll binds to the
         System.Security.Permissions assembly for CodeAccessPermission, PermissionState and
         IUnrestrictedPermission, none of which netstandard2.0 provides. 5.0.0 was unsafe for every
         net5+ consumer, though no netstandard2.0 restore showed it: its net5.0 dependency group pulls
         System.Windows.Extensions 5.0.0, and with it System.Drawing.Common 5.0.0 — GHSA-rxg9-xrhp-64gj
         (remote code execution, critical). From 8.0 on, System.Windows.Extensions has no dependencies,
         so System.Drawing.Common leaves the graph altogether. 10.0 is the supported LTS line. -->
    <PackageVersion Include="System.Security.Permissions" Version="10.0.15" />
  </ItemGroup>

  <!-- Roslyn source generator (Trinity.Generator) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Store-integration tests self-provision their servers via Docker (ADR-0036). -->
    <PackageVersion Include="Testcontainers" Version="3.10.0" />
    <!-- Benchmarks only (benchmarks/Trinity.Benchmarks), never referenced by shipping code. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
