<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Core / store library dependencies -->
  <ItemGroup>
    <!-- dotNetRDF 3.x is split: Core = RDF/SPARQL engine, Client = HTTP storage connectors. -->
    <PackageVersion Include="dotNetRdf.Core" Version="3.5.2" />
    <PackageVersion Include="dotNetRdf.Client" Version="3.5.2" />
    <!-- RdfsReasoner (in-memory inferencing) moved out of Core in 3.x. -->
    <PackageVersion Include="dotNetRdf.Inferencing" Version="3.5.2" />
    <!-- 13.0.4 is the floor dotNetRdf.Core 3.5.2 requires. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="System.Composition" Version="1.1.0" />    <PackageVersion Include="System.Data.Common" Version="4.3.0" />
    <PackageVersion Include="System.Security.Permissions" Version="5.0.0" />
  </ItemGroup>

  <!-- Roslyn source generator (Trinity.Generator) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="ini-parser" Version="2.5.2" />
    <!-- Store-integration tests self-provision their servers via Docker (ADR-0036). -->
    <PackageVersion Include="Testcontainers" Version="3.10.0" />
  </ItemGroup>

</Project>
