<Project>

  <!-- Shared metadata for all Trinity projects. Per-project files still set Title,
       Description, PackageId, AssemblyName, RootNamespace, PackageTags and IsPackable. -->
  <PropertyGroup>
    <!-- Attribution: Semiodesk GmbH was dissolved, so the authors are named directly. The package id
         and product stay Semiodesk.Trinity for continuity with the 1.x releases. The copyright keeps
         the company's historic notice — the MIT headers in the source files carry the same one — and
         adds the current holder. -->
    <Company>Moritz Eberl</Company>
    <Authors>Moritz Eberl</Authors>
    <Product>Semiodesk.Trinity</Product>
    <Copyright>Copyright © 2015-2020 Semiodesk GmbH, © 2026 Moritz Eberl</Copyright>
    <!-- The single source of the release version. Declared as VersionPrefix (not Version) so CI can
         append a prerelease label with -p:VersionSuffix=…; setting Version directly would ignore it.
         A plain build still produces exactly 2.0.0. Assembly/file versions cannot carry a prerelease
         label, so they stay fixed. -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <!-- Rendered on the nuget.org listing page. Kept to the headline of the current release only —
         the full history lives in CHANGELOG.md, which this points at. Update both together; the
         RELEASING.md gate checks for it. -->
    <PackageReleaseNotes>Release candidate 4 carries everything since rc.3. Breaking: language-tagged text is now declared by property type (string, LocalizedString, LocalizedStringCollection, LangString), and Resource.Language and the languageInvariant flag are removed. A property still declared string over tagged data compiles but reads null, so check those first. A mapped System.Uri property is refused at registration (declare it UriRef), IModelGroup.DefaultModel is removed, and Fuseki needs 5.x. New: an Oxigraph store backend; layered views that read a baseline with a pending change applied, stage commits into it, and accept or discard it; and RDFS inferencing in the in-memory store. Fixes several defects that reported success while losing data or answering wrongly: Read(update: true) replaced the graph on Fuseki and GraphDB, a bulk UpdateResources merged instead of replacing, ModelGroup.ContainsResource returned true for any blank node, and UriRef ignored its fragment on .NET 10. Reading a large resource and reading many resources are now linear rather than quadratic, and mapped collections on Virtuoso are no longer capped at a few hundred members. See CHANGELOG.md for the migration notes and known issues.</PackageReleaseNotes>
    <PackageProjectUrl>https://trinity-rdf.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/semiodesk/trinity-rdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Package health: Source Link, embedded symbols and a deterministic build. These are what NuGet
       Package Explorer's health checks look for, and together they let a consumer step into Trinity's
       source from a stack trace. Source Link itself needs no package reference — it ships in the SDK. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Embedded rather than a separate .snupkg: the package is then self-contained, so symbols cannot
         go missing and the manual release has one artifact per project to push instead of two. -->
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <!-- Normalizes source paths so a Release build is byte-for-byte reproducible. Applied to every
         Release build, not just CI, because releases are packed manually (see RELEASING.md). -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Readme rendered on the nuget.org listing page (another Package Explorer health check).
       PackageReadmeFile names the file *inside* the package, so the file itself has to be packed
       as well — hence the None item with the flat PackagePath. The repo README documents the core
       package and the store backends together, so all packable projects share the one file.
       Projects with IsPackable=false simply ignore both. -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
