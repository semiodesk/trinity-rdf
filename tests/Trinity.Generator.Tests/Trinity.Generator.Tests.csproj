<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Semiodesk.Trinity.Generator.Tests</AssemblyName>
    <RootNamespace>Semiodesk.Trinity.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Needed to drive the generator directly in-process, which is the only way to observe the
         diagnostics it reports; compiling against it only shows what it emits. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Trinity\Trinity.csproj" />
    <!-- Referenced as an analyzer so the mapped test classes in this project are generated, and as a
         normal assembly so the diagnostic tests can instantiate the generator. -->
    <ProjectReference Include="..\..\Trinity.Generator\Trinity.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
