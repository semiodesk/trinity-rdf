<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Semiodesk.Trinity.Generator.Tests</AssemblyName>
    <RootNamespace>Semiodesk.Trinity.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Trinity\Trinity.csproj" />
    <!-- The generator is referenced as an analyzer only (no runtime assembly, no weaver). -->
    <ProjectReference Include="..\..\Trinity.Generator\Trinity.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
