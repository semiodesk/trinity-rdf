<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Semiodesk.Trinity.Vocabulary.Tests</AssemblyName>
    <RootNamespace>Semiodesk.Trinity.Vocabulary.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Used to compile the generated source in-process, which is how the OntologyDiscovery
         reflection contract gets tested rather than assumed. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Trinity\Trinity.csproj" />
    <ProjectReference Include="..\..\Trinity.Vocabulary\Trinity.Vocabulary.csproj" />
  </ItemGroup>

  <!-- The real vocabularies are the test corpus. Two of the filenames contain spaces on purpose. -->
  <ItemGroup>
    <None Include="..\..\Trinity.Tests\Ontologies\*.*" LinkBase="Ontologies" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
